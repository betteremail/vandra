<table class="w-full" width="640" cellspacing="0" cellpadding="0" border="0" style="width:640px;">
  <tr>
    <td height="56" style="height:56px;">&nbsp;</td>
  </tr>
  <tr>
    <td>
      <table width="100%" cellspacing="0" cellpadding="0" border="0">
        <tr>
          <td width="40" style="width:40px;">&nbsp;</td>
          <td class="bd-line" style="border-top:2px solid {{ global.line }};">
          </td>
          <td width="40" style="width:40px;">&nbsp;</td>
        </tr>
        <tr>
          <td colspan="3" height="40" style="height:40px;">&nbsp;</td>
        </tr>
        <tr>
          <td width="40" style="width:40px;">&nbsp;</td>
          <td>
            <table width="100%" cellspacing="0" cellpadding="0" border="0">
              <tr>
                <td class="tx-ink" style="font-family:{{ global.font_body }}; font-weight:600; font-size:16px; line-height:26px; color:{{ global.ink }};">{{ intro.greeting }}</td>
              </tr>
              <tr>
                <td height="10" style="height:10px; font-size:1px; line-height:1px; mso-line-height-rule:exactly;">&nbsp;</td>
              </tr>
              <tr>
                <td class="tx-body" style="font-family:{{ global.font_body }}; font-size:15px; line-height:26px; color:{{ global.granite }};">{{ intro.body }}</td>
              </tr>
              <tr>
                <td height="14" style="height:14px; font-size:1px; line-height:1px; mso-line-height-rule:exactly;">&nbsp;</td>
              </tr>
              <tr>
                <td class="tx-faint" style="font-family:{{ global.font_mono }}; font-size:12px; line-height:18px; letter-spacing:1px; color:{{ global.faint }};">{{ intro.signoff }}</td>
              </tr>
            </table>
          </td>
          <td width="40" style="width:40px;">&nbsp;</td>
        </tr>
      </table>
    </td>
  </tr>
</table>
