</td></tr>
<tr><td height="32" style="height:32px;">&nbsp;</td></tr>
<tr><td style="border-top:1px solid #33413A; font-size:1px; line-height:1px; mso-line-height-rule:exactly;">&nbsp;</td></tr>
<tr><td height="24" style="height:24px;">&nbsp;</td></tr>
<tr><td align="center" style="font-family:{{ global.font_body }}; font-size:12px; line-height:20px; color:#93A096;">{{ template.footer_content.company_address }}</td></tr>
<tr><td align="center" style="font-family:{{ global.font_body }}; font-size:12px; line-height:20px; color:#93A096;">{{ template.footer_content.signup_note }}</td></tr>
<tr><td height="16" style="height:16px; font-size:1px; line-height:1px; mso-line-height-rule:exactly;">&nbsp;</td></tr>
<tr><td align="center" style="font-family:{{ global.font_body }}; font-size:12px; line-height:20px; color:#93A096;">
