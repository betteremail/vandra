<style type="text/css">
#outlook a { padding: 0; }
.ReadMsgBody, .ExternalClass { width: 100%; }
.ExternalClass, .ExternalClass p, .ExternalClass span, .ExternalClass font, .ExternalClass td, .ExternalClass div { line-height: 100%; }
body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
td, a, span { border-collapse: collapse; mso-line-height-rule: exactly; }
table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
img { -ms-interpolation-mode: bicubic; border: 0; line-height: 100%; outline: none; text-decoration: none; }
table { border-collapse: collapse !important; }
body { margin: 0 !important; padding: 0 !important; width: 100% !important; -webkit-font-smoothing: antialiased; }
a { color: #1A2420; text-decoration: none; }
a:active { color: #1A2420; }
a:visited { color: #1A2420; }
@media screen and (max-device-width: 640px), screen and (max-width: 640px) {
.w-full { width: 100% !important; height: auto !important; }
.w-90p { width: 91% !important; height: auto !important; }
.break { width: 100% !important; display: block; clear: both; }
.hide { display: none !important; }
.show { display: block !important; }
.center-m { text-align: center !important; }
.h-hero { font-size: 34px !important; line-height: 38px !important; }
.h-quote { font-size: 20px !important; line-height: 28px !important; }
}
@media (prefers-color-scheme: dark) {
.bg-page { background-color: #121714 !important; }
.bg-mist { background-color: #1B231E !important; }
.bg-deep { background-color: #1F2C25 !important; }
.tx-ink { color: #ECF0EA !important; }
.tx-body { color: #A9B3AA !important; }
.tx-faint { color: #7E8880 !important; }
.bd-line { border-color: #3A453D !important; }
}
</style>
</head>
<body class="bg-page" style="margin:0; padding:0; background-color:#EEF0EC;">
<table width="100%" cellspacing="0" cellpadding="0" border="0" class="bg-page" style="background-color:#EEF0EC;">
<tr>
<td align="center">
<table class="w-full" width="640" cellspacing="0" cellpadding="0" border="0" style="width:640px;">
<tr><td height="28" style="height:28px;">&nbsp;</td></tr>
<tr><td>
<table width="100%" cellspacing="0" cellpadding="0" border="0"><tr>
<td width="40" style="width:40px;">&nbsp;</td>
<td align="left" valign="middle">
<a href="{{ template.header_brand.url.url }}" target="_blank">
<table cellspacing="0" cellpadding="0" border="0"><tr>
<td valign="middle" width="30" style="width:30px;">{{ template.header_brand.logo | imgTag: width: 30, height: 30, dpr: 3, altText: "Vandra" }}</td>
<td valign="middle" width="12" style="width:12px;">&nbsp;</td>
<td valign="middle" class="tx-ink" style="font-family:{{ global.font_heading }}; font-weight:900; font-size:20px; line-height:30px; letter-spacing:4px; color:{{ global.ink }};">VANDRA</td>
</tr></table>
</a>
</td>
<td align="right" valign="middle" class="hide" style="font-family:{{ global.font_mono }}; font-size:11px; line-height:30px; letter-spacing:2px; color:{{ global.granite }};">
{% for link in template.header_nav %}<a href="{{ link.url.url }}" target="_blank" class="tx-body" style="color:{{ global.granite }};">{{ link.label }}</a>{% unless forloop.last %}&nbsp;·&nbsp;{% endunless %}{% endfor %}
</td>
<td width="40" style="width:40px;">&nbsp;</td>
</tr></table>
</td></tr>
<tr><td height="24" style="height:24px;">&nbsp;</td></tr>
</table>
{{ content }}
<table class="w-full" width="640" cellspacing="0" cellpadding="0" border="0" style="width:640px;">
<tr><td style="background-color:{{ global.ink }};">
<table width="100%" cellspacing="0" cellpadding="0" border="0">
<tr><td height="52" style="height:52px;">&nbsp;</td></tr>
<tr>
<td width="40" style="width:40px;">&nbsp;</td>
<td align="center">
<table width="100%" cellspacing="0" cellpadding="0" border="0">
<tr><td align="center" style="font-family:{{ global.font_heading }}; font-weight:900; font-size:22px; line-height:28px; letter-spacing:6px; color:#F2F5F0;">VANDRA</td></tr>
<tr><td height="8" style="height:8px; font-size:1px; line-height:1px; mso-line-height-rule:exactly;">&nbsp;</td></tr>
<tr><td align="center" style="font-family:{{ global.font_mono }}; font-size:11px; line-height:16px; letter-spacing:2px; color:#93A096;">{{ template.footer_content.tagline }}</td></tr>
<tr><td height="28" style="height:28px;">&nbsp;</td></tr>
